/// Vaporize-owned cross-platform project truth.
///
/// Adapter-specific declarations remain inherited while a project migrates.
/// Xcode consumes `targets`; WCode and SwiftPM consume `platformTargets`.
extends "../../../../../wrkstrm-core/private/universal/domain/build/spm/xcode-project-definition/Pkl/XcodeProjectDefinition.pkl"

typealias VaporizePlatform = "macos" | "windows" | "linux"
typealias VaporizeAdapter = "xcode" | "swiftpm" | "wcode"
typealias VaporizePresentation = "swiftui" | "swift-uui"
typealias VaporizeUIBackend = "appkit" | "uikit" | "winui"
typealias VaporizeToolSurface = "cli" | "stui" | "tui" | "sd"
typealias VaporizeToolLanguage = "j" | "p" | "s"
typealias VaporizeToolOwnerType = "coll"
typealias VaporizeServiceScope = "user" | "system"
typealias VaporizeServiceActivation = "login" | "manual"
typealias VaporizeServiceRestartPolicy = "never" | "on-failure" | "always"

class VaporizePlatformResource {
  path: String
  mode: "copy" | "process"
  destination: String?
  includes: Listing<String>?
  excludes: Listing<String>?
  optional: Boolean = false
}

class VaporizePlatformTarget {
  platform: VaporizePlatform
  adapter: VaporizeAdapter
  product: String
  packagePath: String?
  entryPoint: String?
  presentation: VaporizePresentation?
  backend: VaporizeUIBackend?
  resources: Listing<VaporizePlatformResource>?
}

/// One stable owner namespace shared by every projected member of a tool family.
class VaporizeToolOwner {
  slug: String
  type: VaporizeToolOwnerType = "coll"
}

/// One interaction surface backed by a concrete source product.
///
/// `digi = true` evolves the same deterministic tool with CommonAI intelligence;
/// it does not replace the surface or move effects authority out of the source product.
class VaporizeToolVariant {
  surface: VaporizeToolSurface
  language: VaporizeToolLanguage = "s"
  digi: Boolean = false
  sourceProduct: String
}

/// Project-level declaration from which Vaporize projects CLI-family artifacts.
class VaporizeToolFamily {
  packagePath: String = "."
  owner: VaporizeToolOwner
  variants: Mapping<String, VaporizeToolVariant>
}

class VaporizeServiceHealthCheck {
  kind: "http"
  url: String
}

/// A long-running process that Vaporize projects into the host's native
/// service manager. Local developer services should normally use user scope.
class VaporizeService {
  scope: VaporizeServiceScope = "user"
  activation: VaporizeServiceActivation = "login"
  executable: String
  arguments: Listing<String> = new {}
  workingDirectory: String?
  environment: Mapping<String, String> = new {}
  restartPolicy: VaporizeServiceRestartPolicy = "on-failure"
  standardOutputPath: String?
  standardErrorPath: String?
  healthCheck: VaporizeServiceHealthCheck?
}

platformTargets: Mapping<String, VaporizePlatformTarget> = new {}
toolFamilies: Mapping<String, VaporizeToolFamily> = new {}
services: Mapping<String, VaporizeService> = new {}
